# goodbizz environment contract (versioned). Copy to .env and fill in.
# Secrets never belong in this file.

# LLM provider (any OpenAI-compatible chat completions endpoint)
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=sk-replace-me
LLM_API_MODEL=gpt-4o-mini

# System One decider provider (Jev, Laya, local runtime, or a compatible gateway)
DECISION_API_URL=https://api.laya.studio/v1/systemone
DECISION_API_KEY=replace-me
DECISION_API_MODEL=systemone-latest

# Service
PORT=3000
DATABASE_URL=app.db
LOG_LEVEL=info
APP_ENV=development
SESSION_SECRET=replace-with-32-random-bytes-at-least
# Directory where study artifacts (markdown, csv, json, pdf) are written
GOODBIZZ_STUDIES_DIR=estudo
