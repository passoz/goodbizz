# goodbizz environment contract (versioned). Copy to .env and fill in.
# Secrets never belong in this file.

# LLM provider (any OpenAI-compatible chat completions endpoint)
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=sk-replace-me
LLM_API_MODEL=gpt-4o-mini

# System One decider provider (Jev, Laya, local runtime, or a compatible gateway)
DECISION_API_URL=https://api.laya.studio/v1/systemone
DECISION_API_KEY=replace-me
DECISION_API_MODEL=systemone-latest

# Service
PORT=3000
DATABASE_URL=app.db
LOG_LEVEL=info
APP_ENV=development
SESSION_SECRET=replace-with-32-random-bytes-at-least
# Directory where study artifacts (markdown, csv, json, pdf) are written
GOODBIZZ_STUDIES_DIR=estudo

# Simulated providers. GOODBIZZ_MOCK=1 simulates both; the per-provider flags allow mixed mode
# (e.g. real text from the LLM while the decider is simulated, to validate one side without cost).
GOODBIZZ_MOCK=0
GOODBIZZ_MOCK_LLM=0
GOODBIZZ_MOCK_DECIDER=0

# Limite de cada chamada ao provedor de IA, em segundos (5..3600). O `deepseek-flash` gera ~8 mil
# tokens de saida em ~37 s e um plano executivo passa de 20 mil: com 60 s o documento era cortado no
# meio e o estudo falhava por timeout.
GOODBIZZ_LLM_TIMEOUT=300

# Estimativa de custo por estudo (US$ por 1M de tokens). Os valores abaixo são a tabela OFICIAL do
# `deepseek-flash` em horário off-peak (em pico, dobram); ajuste para o seu plano/roteador.
GOODBIZZ_PRICE_LLM_INPUT_PER_MTOK=0.15
GOODBIZZ_PRICE_LLM_CACHED_INPUT_PER_MTOK=0.003
GOODBIZZ_PRICE_LLM_OUTPUT_PER_MTOK=0.6
# Decisor: Jev 1.13 da TypeSafe (api.typesafe.ai) cobra US$ 0,042/1M de tokens de ENTRADA; a saída
# é grátis. Deixe em 0 se o decisor for um motor gratuito (ex.: motor `jev` do 9router).
GOODBIZZ_PRICE_DECIDER_INPUT_PER_MTOK=0.042
GOODBIZZ_PRICE_DECIDER_OUTPUT_PER_MTOK=0
# Cotação só para exibir o custo em R$ (0 desliga).
GOODBIZZ_USD_BRL=0
