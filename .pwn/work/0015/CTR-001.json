{
  "contract_version": "4.0",
  "task_id": "1.1",
  "work_id": "0015",
  "title": "A fase de pesquisa roda antes do brief com 6 a 10 buscas geradas pelo LLM",
  "risk": {
    "level": "L2",
    "reasons": [
      "A mudança atravessa pipeline, cache, persistência ou credencial de provedor",
      "A task altera o que o operador lê no estudo e o que fica gravado"
    ]
  },
  "validation_strategy": "tdd-strict",
  "behavioral_contract": {
    "scenarios": [
      {
        "id": "SCENARIO-1.1-01",
        "given": "Dado o comportamento declarado: antes do brief o pipeline pede as buscas ao LLM, limita a lista a 6 a 10 itens, consulta o provedor de busca e extrai evidências que entram no resultado do estudo",
        "when": "Quando `bun --config=tests/bunfig.focus.toml test tests/research-phase.test.ts -t \"FR-002\"` é executado",
        "then": "Então o pipeline pesquisa antes do brief e devolve as evidências extraídas (FR-002)"
      }
    ]
  },
  "change_contract": {
    "target_files": [
      "src/application/research.ts",
      "src/application/generate-study.ts",
      "src/application/prompts.ts",
      "src/domain/types.ts",
      "src/domain/ports.ts",
      "tests/bunfig.focus.toml",
      "tests/research-phase.test.ts"
    ],
    "affected_components": [
      "research-pipeline"
    ]
  },
  "architecture_contract": {
    "invariants": [
      "src/domain não importa application nem infrastructure",
      "Acesso a dados novo passa por Drizzle, sem SQL cru",
      "A chave de busca nunca aparece em log, resposta HTTP, artefato ou página",
      "Testes offline e determinísticos"
    ]
  },
  "acceptance_contract": {
    "commands": [
      "bun --config=tests/bunfig.focus.toml test tests/research-phase.test.ts -t \"FR-002\"",
      "bun test",
      "bun run check",
      "bunx eslint . && bunx prettier --check ."
    ],
    "required_evidence": [
      "evidence.json"
    ]
  },
  "scope_contract": {
    "write_allow": [
      "src/application/research.ts",
      "src/application/generate-study.ts",
      "src/application/prompts.ts",
      "src/domain/types.ts",
      "src/domain/ports.ts",
      "tests/bunfig.focus.toml",
      "tests/research-phase.test.ts"
    ],
    "write_deny": [
      ".git/**",
      "package.json",
      ".env",
      ".env.local"
    ],
    "out_of_scope": [
