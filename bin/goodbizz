#!/bin/sh
# Single entrypoint for goodbizz tools.
# install.sh (or a manual symlink) can point ~/bin/goodbizz at this file.
set -eu

TARGET=$(readlink -f -- "$0" 2>/dev/null || echo "$0")
ROOT=$(CDPATH= cd -- "$(dirname -- "$TARGET")/.." && pwd)
BUN=${GOODBIZZ_BUN:-bun}

check_bun() {
  if ! command -v "$BUN" >/dev/null 2>&1; then
    echo "goodbizz: runtime '$BUN' not found" >&2
    echo "  install Bun 1.4+ (https://bun.sh) or set GOODBIZZ_BUN" >&2
    exit 127
  fi
}

case "${1:-}" in
  generate|gerar|study|estudo)
    shift
    check_bun
    exec "$BUN" "$ROOT/src/cli.ts" generate "$@"
    ;;
  diagnose|diagnosticar)
    shift
    check_bun
    exec "$BUN" "$ROOT/src/cli.ts" diagnose "$@"
    ;;
  recalibrate|recalibrar)
    shift
    check_bun
    exec "$BUN" "$ROOT/src/cli.ts" recalibrate "$@"
    ;;
  serve|servico|server)
    shift
    check_bun
    exec "$BUN" "$ROOT/src/cli.ts" serve "$@"
    ;;
  help|ajuda|-h|--help|"")
    check_bun
    exec "$BUN" "$ROOT/src/cli.ts" help
    ;;
  *)
    echo "goodbizz: unknown subcommand: $1" >&2
    echo >&2
    check_bun
    exec "$BUN" "$ROOT/src/cli.ts" help
    ;;
esac
