#!/bin/sh
# Single entrypoint for goodbizz tools.
# install.sh creates a symlink to this file in ~/bin (or your specified PATH).
set -eu

TARGET=$(readlink -f -- "$0" 2>/dev/null || echo "$0")
ROOT=$(CDPATH= cd -- "$(dirname -- "$TARGET")/.." && pwd)
PY=${GOODBIZZ_PYTHON:-python3}

usage() {
  cat <<'EOF'
goodbizz — from a single niche prompt to an executive business study

USAGE
  goodbizz <subcommand> [options]

SUBCOMMANDS
  generate "<niche>"     Generate full study: brief, ideas, System One decider evaluation,
                         and per-idea business plan. Outputs markdown, csv, json, and pdf.
  diagnose               Test whether pain probes provide coherent and stable signal
                         with your decider. Run this BEFORE recalibrating.
  recalibrate <data>     Grid-search decision thresholds against a labeled dataset
                         (dados.json from previous runs).
  help                   Show this message.

EXAMPLES
  goodbizz generate "clinicas odontologicas em cidade media" --ideas 8 --pdf
  goodbizz generate "any niche" --ideas 5 --mock           # offline demo, no credentials
  goodbizz generate "your niche" --ideas-file ideas.json \
      --eval-only --output collection --mock-llm           # collects evaluation data only

  goodbizz diagnose --ideas examples.json --niche "your niche"
  goodbizz recalibrate collection/dados.json

OPTIONS
  Run `goodbizz <subcommand> --help` for full parameter options.

CONFIGURATION
  LLM and decider credentials can be set via environment variables or CLI flags:
    GOODBIZZ_LLM_URL, GOODBIZZ_LLM_MODEL, GOODBIZZ_LLM_KEY (--llm-url, --llm-model, --llm-key)
    GOODBIZZ_DECISOR_URL, GOODBIZZ_DECISOR_MODEL, GOODBIZZ_DECISOR_KEY (--decider-url, --decider-model, --decider-key)
  Compatible deciders: Jev, Laya (cloud/local), generic System One endpoints or local daemons.
  Without credentials, use --mock (fully simulated) or --mock-llm / --mock-decider.
EOF
}

check_python() {
  if ! command -v "$PY" >/dev/null 2>&1; then
    echo "goodbizz: interpreter '$PY' not found" >&2
    echo "  set GOODBIZZ_PYTHON or install Python 3.10+" >&2
    exit 127
  fi
  if ! "$PY" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)'; then
    echo "goodbizz: requires Python 3.10 or newer (found $("$PY" -V 2>&1))" >&2
    exit 1
  fi
}

case "${1:-}" in
  generate|gerar|study|estudo)
    shift
    check_python
    exec "$PY" "$ROOT/generate_study.py" "$@"
    ;;
  recalibrate|recalibrar)
    shift
    check_python
    exec "$PY" "$ROOT/recalibrate.py" "$@"
    ;;
  diagnose|diagnosticar)
    shift
    check_python
    exec "$PY" "$ROOT/diagnose.py" "$@"
    ;;
  help|ajuda|-h|--help|"")
    usage
    ;;
  *)
    echo "goodbizz: unknown subcommand: $1" >&2
    echo >&2
    usage >&2
    exit 2
    ;;
esac
